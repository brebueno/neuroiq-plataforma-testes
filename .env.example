# Stripe — configure estas variáveis NA VERCEL (Settings → Environment Variables).
# NUNCA coloque a chave secreta real neste repositório. O .env está no .gitignore.

# Chave SECRETA (rotacionada!) — só no back-end. Cole a sua chave secreta aqui.
STRIPE_SECRET_KEY=COLE_SUA_CHAVE_SECRETA_AQUI

# Preço RECORRENTE mensal (R$159,00/mês, BRL) — obrigatório
STRIPE_PRICE_MONTHLY=price_xxxxxxxxxxxxx
# Preço AVULSO de entrada (R$7,00, one-time) — cobrado no checkout
STRIPE_PRICE_TRIAL=price_xxxxxxxxxxxxx

# Dias de trial no recorrente antes da 1ª cobrança de R$159. Padrão: 7
STRIPE_TRIAL_DAYS=7

# Signing secret do webhook (whsec_...) — Stripe → Developers → Webhooks → endpoint
STRIPE_WEBHOOK_SECRET=COLE_O_SIGNING_SECRET_AQUI
